<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Renkler docs/tasarim/gorsel-stil.html'deki onaylı çizimden. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WindowBrush" Color="#eef0f5" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#f7f8fb" />
      <SolidColorBrush x:Key="CardBrush" Color="#ffffff" />
      <SolidColorBrush x:Key="HoverBrush" Color="#e6e9f1" />
      <SolidColorBrush x:Key="TextBrush" Color="#1b1e2b" />
      <SolidColorBrush x:Key="Text2Brush" Color="#6b7085" />
      <SolidColorBrush x:Key="LineBrush" Color="#dfe2ea" />
      <SolidColorBrush x:Key="AccentBrush" Color="#3d6dfd" />
      <!-- Fluent'in gri vurgu renkleri yerine çizimdeki zemin. -->
      <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#e6e9f1" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#e6e9f1" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#e6e9f1" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="#e6e9f1" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#e6e9f1" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#e6e9f1" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#e6e9f1" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#e6e9f1" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#e6e9f1" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="WindowBrush" Color="#151827" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#1a1d2e" />
      <SolidColorBrush x:Key="CardBrush" Color="#252839" />
      <SolidColorBrush x:Key="HoverBrush" Color="#2b2f43" />
      <SolidColorBrush x:Key="TextBrush" Color="#e8eaf2" />
      <SolidColorBrush x:Key="Text2Brush" Color="#8d92a8" />
      <SolidColorBrush x:Key="LineBrush" Color="#262a3c" />
      <SolidColorBrush x:Key="AccentBrush" Color="#4c7dff" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#2b2f43" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#2b2f43" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#2b2f43" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="#2b2f43" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#2b2f43" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#2b2f43" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#2b2f43" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#2b2f43" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#2b2f43" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="GroupTileBrush" Color="#1f4f7a" />
  <SolidColorBrush x:Key="ConnectedBrush" Color="#2fbf71" />
  <SolidColorBrush x:Key="NoticeBrush" Color="#e5673a" />
  <SolidColorBrush x:Key="SessionBrush" Color="#0f1424" />

  <x:Double x:Key="BodyFontSize">15</x:Double>
  <x:Double x:Key="SecondaryFontSize">14</x:Double>
  <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">8</CornerRadius>

  <StreamGeometry x:Key="WindowsLogo">M0,0 H7.4 V7.4 H0 Z M8.6,0 H16 V7.4 H8.6 Z M0,8.6 H7.4 V16 H0 Z M8.6,8.6 H16 V16 H8.6 Z</StreamGeometry>
  <StreamGeometry x:Key="FolderIcon">M1,3.5 C1,2.7 1.7,2 2.5,2 H6.1 L7.7,3.8 H13.5 C14.3,3.8 15,4.5 15,5.3 V12.5 C15,13.3 14.3,14 13.5,14 H2.5 C1.7,14 1,13.3 1,12.5 Z</StreamGeometry>
  <StreamGeometry x:Key="ServerIcon">M2,1.5 H14 A1,1 0 0 1 15,2.5 V6.5 A1,1 0 0 1 14,7.5 H2 A1,1 0 0 1 1,6.5 V2.5 A1,1 0 0 1 2,1.5 Z M2,8.5 H14 A1,1 0 0 1 15,9.5 V13.5 A1,1 0 0 1 14,14.5 H2 A1,1 0 0 1 1,13.5 V9.5 A1,1 0 0 1 2,8.5 Z</StreamGeometry>
  <StreamGeometry x:Key="GearIcon">M8,5.2 A2.8,2.8 0 1 0 8,10.8 A2.8,2.8 0 1 0 8,5.2 Z M7,0 H9 L9.4,2.1 A6,6 0 0 1 11,2.8 L12.8,1.6 L14.4,3.2 L13.2,5 A6,6 0 0 1 13.9,6.6 L16,7 V9 L13.9,9.4 A6,6 0 0 1 13.2,11 L14.4,12.8 L12.8,14.4 L11,13.2 A6,6 0 0 1 9.4,13.9 L9,16 H7 L6.6,13.9 A6,6 0 0 1 5,13.2 L3.2,14.4 L1.6,12.8 L2.8,11 A6,6 0 0 1 2.1,9.4 L0,9 V7 L2.1,6.6 A6,6 0 0 1 2.8,5 L1.6,3.2 L3.2,1.6 L5,2.8 A6,6 0 0 1 6.6,2.1 Z</StreamGeometry>
  <StreamGeometry x:Key="EyeIcon">M2,12 C2,12 6,5 12,5 C18,5 22,12 22,12 C22,12 18,19 12,19 C6,19 2,12 2,12 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 Z</StreamGeometry>
  <StreamGeometry x:Key="SearchIcon">M10.5,3 A7.5,7.5 0 1 1 10.49,3 Z M16,16 L21,21</StreamGeometry>
</ResourceDictionary>
