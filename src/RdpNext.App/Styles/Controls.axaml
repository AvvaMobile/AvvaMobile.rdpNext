<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>

  <Style Selector="Button.add">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.add:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="Padding" Value="8,10" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>

  <Style Selector="Border.tile">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.tile-small">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="8,7,10,7" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="Button.tab-close">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tab-close">
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="FontSize" Value="17" />
  </Style>

  <!-- Düzenleme sekmesi (docs/tasarim/duzenle-sekmesi.png) -->
  <Style Selector="StackPanel.form">
    <Setter Property="Spacing" Value="18" />
    <Setter Property="Margin" Value="28,22" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <!-- Hazır temanın 14 px'i yerine bizim gövde boyutumuz (15 px). -->
  <Style Selector="TextBox, ComboBox, ComboBoxItem, Button, MenuItem">
    <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
  </Style>
  <Style Selector="TextBox.field">
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="TextBox.field, ComboBox.field">
    <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ToggleButton.eye">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="ToggleButton.eye:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.swatches">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="Button.primary, Button.secondary">
    <Setter Property="Padding" Value="26,10" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button.danger-text">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource NoticeBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Padding" Value="26,10" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{StaticResource NoticeBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TabControl.editor">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.editor TabItem">
    <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="MinHeight" Value="46" />
  </Style>
  <Style Selector="TabControl.editor TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TabControl.editor TabItem /template/ :is(Control)#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TabControl.editor TabItem">
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TabControl.editor TabItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TabControl.editor TabItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Sağ tık menüsü: yuvarlak köşe, ferah satırlar, Sil kırmızı -->
  <Style Selector="ContextMenu">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ContextMenu MenuItem">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ContextMenu MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ContextMenu MenuItem.danger">
    <Setter Property="Foreground" Value="{StaticResource NoticeBrush}" />
  </Style>
  <Style Selector="ContextMenu Separator">
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
  </Style>
</Styles>
