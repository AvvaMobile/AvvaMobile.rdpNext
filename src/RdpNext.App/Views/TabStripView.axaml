<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpNext.App.ViewModels"
             xmlns:v="using:RdpNext.App.Views"
             xmlns:s="using:RdpNext.App.Strings"
             x:Class="RdpNext.App.Views.TabStripView"
             x:DataType="vm:MainWindowViewModel">
  <Panel>
  <ListBox x:Name="TabStrip" VerticalAlignment="Center" Classes="tabs" ItemsSource="{Binding Sessions.Tabs}"
             SelectedItem="{Binding Sessions.Selected}" Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Hidden">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="6" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:TabViewModel">
          <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent">
            <StackPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static s:Strings.CloseTab}"
                          Command="{Binding $parent[v:TabStripView].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="{x:Static s:Strings.CloseOtherTabs}"
                          Command="{Binding $parent[v:TabStripView].((vm:MainWindowViewModel)DataContext).CloseOtherTabsCommand}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="{x:Static s:Strings.Reconnect}" IsVisible="{Binding CanReconnect}"
                          Command="{Binding $parent[v:TabStripView].((vm:MainWindowViewModel)DataContext).ReconnectTabCommand}"
                          CommandParameter="{Binding}" />
              </ContextMenu>
            </StackPanel.ContextMenu>
            <Border Classes="tile-small" Background="{Binding Color, Converter={x:Static v:Converters.TabTileBrush}}">
              <Panel>
                <v:ServerIconView Icon="{Binding Icon}" Width="12" Height="12"
                                  IsVisible="{Binding !IsEditor}" />
                <Path Data="{StaticResource GearIcon}" Fill="{DynamicResource Text2Brush}" Width="13" Height="13" Stretch="Uniform"
                      IsVisible="{Binding IsEditor}" />
              </Panel>
            </Border>
            <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center"
                       MaxWidth="180" TextTrimming="CharacterEllipsis" />
            <Button Classes="tab-close" Content="×"
                    Command="{Binding $parent[v:TabStripView].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <!-- Sürükle-bırak göstergesi: sekmeler arasına mavi çizgi. -->
    <Canvas IsHitTestVisible="False">
      <Border x:Name="TabDropLine" Width="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" IsVisible="False" />
    </Canvas>
  </Panel>

</UserControl>
