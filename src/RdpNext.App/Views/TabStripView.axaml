<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpNext.App.ViewModels"
             xmlns:v="using:RdpNext.App.Views"
             xmlns:s="using:RdpNext.App.Strings"
             x:Class="RdpNext.App.Views.TabStripView"
             x:DataType="vm:MainWindowViewModel">
  <ListBox x:Name="TabStrip" VerticalAlignment="Center" Classes="tabs" ItemsSource="{Binding Sessions.Tabs}"
             SelectedItem="{Binding Sessions.Selected}" Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Hidden">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="6" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:SessionTabViewModel">
          <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent">
            <StackPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static s:Strings.CloseTab}"
                          Command="{Binding $parent[v:TabStripView].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="{x:Static s:Strings.CloseOtherTabs}"
                          Command="{Binding $parent[v:TabStripView].((vm:MainWindowViewModel)DataContext).CloseOtherTabsCommand}"
                          CommandParameter="{Binding}" />
              </ContextMenu>
            </StackPanel.ContextMenu>
            <Border Classes="tile-small" Background="{Binding Color, Converter={x:Static v:Converters.ServerColorBrush}}">
              <Path Data="{StaticResource WindowsLogo}" Fill="White" Width="12" Height="12" Stretch="Uniform" />
            </Border>
            <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center"
                       MaxWidth="180" TextTrimming="CharacterEllipsis" />
            <Button Classes="tab-close" Content="×"
                    Command="{Binding $parent[v:TabStripView].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

</UserControl>
