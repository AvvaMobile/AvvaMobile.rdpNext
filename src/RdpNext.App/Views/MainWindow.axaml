<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RdpNext.App.ViewModels"
        xmlns:v="using:RdpNext.App.Views"
        x:Class="RdpNext.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="rdpNext"
        Icon="/Assets/rdpNext.png"
        Width="1280" Height="800" MinWidth="800" MinHeight="500"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52">
  <Window.KeyBindings>
    <KeyBinding Gesture="Meta+OemComma" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="52" Background="{DynamicResource WindowBrush}"
            IsVisible="{Binding !IsFullScreen}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
            DoubleTapped="OnTitleBarDoubleTapped">
      <DockPanel x:Name="TitleContent" Margin="14,0">
        <Button x:Name="SidebarToggle" DockPanel.Dock="Left" Classes="sidebar-toggle" Command="{Binding ToggleSidebarCommand}">
          <Path Data="{StaticResource SidebarIcon}" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.5"
                Width="19" Height="15" Stretch="Uniform" />
        </Button>
        <v:TabStripView x:Name="Tabs" Margin="12,0,0,0" />
      </DockPanel>
    </Border>
    <v:SidebarView x:Name="Sidebar" DockPanel.Dock="Left" Width="310" IsVisible="{Binding ShowSidebar}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" />
    <!-- Sağ taraftaki tek çerçeve: oturum da düzenleme formu da hep bunun içinde açılır. -->
    <Border x:Name="ContentFrame" Classes="content-frame" Classes.fullscreen="{Binding IsFullScreen}">
      <ContentControl x:Name="SessionArea" Content="{Binding Sessions.Selected}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:SessionTabViewModel">
            <v:SessionView Name="SessionViewRoot" />
          </DataTemplate>
          <DataTemplate DataType="vm:ServerEditorViewModel">
            <v:ServerEditorView />
          </DataTemplate>
          <DataTemplate DataType="vm:FolderEditorViewModel">
            <v:FolderEditorView />
          </DataTemplate>
          <DataTemplate DataType="vm:SettingsViewModel">
            <v:SettingsView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>
  </DockPanel>
</Window>
