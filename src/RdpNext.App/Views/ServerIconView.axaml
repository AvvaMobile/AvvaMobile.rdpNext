<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RdpNext.App.Views.ServerIconView">
  <!-- Her çizim kendi sabit çerçevesinde ortalı; Viewbox kutucuğa sığdırır. -->
  <Panel>
    <Viewbox x:Name="WindowsGlyph">
      <Path Data="{StaticResource WindowsLogo}" Fill="White" />
    </Viewbox>
    <!-- Penguen: baş, gövde ve ayaklar dolu; göbek ve gözler boşluk. -->
    <Viewbox x:Name="LinuxGlyph" IsVisible="False">
      <Canvas Width="24" Height="24">
        <Path Fill="White" Data="M12,1 A4.2,4.2 0 1 1 12,9.4 A4.2,4.2 0 1 1 12,1 Z M10.6,4 A0.8,0.8 0 1 0 10.6,5.6 A0.8,0.8 0 1 0 10.6,4 Z M13.4,4 A0.8,0.8 0 1 0 13.4,5.6 A0.8,0.8 0 1 0 13.4,4 Z M12,6.2 A6,8 0 1 1 12,22.2 A6,8 0 1 1 12,6.2 Z M12,10.2 A3.6,5.5 0 1 0 12,21.2 A3.6,5.5 0 1 0 12,10.2 Z M8.5,20.4 A2.6,1.3 0 1 1 8.5,23 A2.6,1.3 0 1 1 8.5,20.4 Z M15.5,20.4 A2.6,1.3 0 1 1 15.5,23 A2.6,1.3 0 1 1 15.5,20.4 Z" />
      </Canvas>
    </Viewbox>
    <Viewbox x:Name="SshGlyph" IsVisible="False">
      <Canvas Width="24" Height="24">
        <Path Fill="White" Data="M2,5.4 L3.4,4 L11.4,12 L3.4,20 L2,18.6 L8.6,12 Z M12,18 H22 V20 H12 Z" />
      </Canvas>
    </Viewbox>
  </Panel>
</UserControl>
