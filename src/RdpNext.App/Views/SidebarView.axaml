<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpNext.App.ViewModels"
             xmlns:v="using:RdpNext.App.Views"
             xmlns:s="using:RdpNext.App.Strings"
             x:Class="RdpNext.App.Views.SidebarView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource SidebarBrush}">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="12,14,12,8">
      <TextBlock x:Name="NoticeText"
                 Text="{Binding Notice}"
                 IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Foreground="{StaticResource NoticeBrush}"
                 FontSize="{StaticResource SecondaryFontSize}"
                 TextWrapping="Wrap" />
      <!-- DENEME 1: ekle düğmeleri arama kutusunun sağında, yalnız ikon. -->
      <Grid ColumnDefinitions="*,8,Auto,6,Auto">
        <TextBox x:Name="SearchBox" Classes="search" Watermark="{x:Static s:Strings.Search}" Text="{Binding Tree.Query}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ConnectFirstMatchCommand}" />
          </TextBox.KeyBindings>
          <TextBox.InnerLeftContent>
            <Path Data="{StaticResource SearchIcon}" Stroke="{DynamicResource Text2Brush}" StrokeThickness="2"
                  Width="14" Height="14" Stretch="Uniform" Margin="12,0,4,0" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <Button x:Name="AddServerButton" Grid.Column="2" Classes="add icon" Command="{Binding NewServerCommand}"
                ToolTip.Tip="{x:Static s:Strings.AddServer}">
          <Panel Width="19" Height="19">
            <Path Data="{StaticResource ServerIcon}" Fill="White" Width="15" Height="15" Stretch="Uniform"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <!-- Artı, düğme renginde bir halkanın içinde: simgeden ayrı görünsün. -->
            <Border Width="11" Height="11" CornerRadius="6" Background="{DynamicResource ButtonBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
              <Path Data="{StaticResource PlusIcon}" Stroke="White" StrokeThickness="1.8" Width="7" Height="7" Stretch="Uniform" />
            </Border>
          </Panel>
        </Button>
        <Button x:Name="AddFolderButton" Grid.Column="4" Classes="add icon" Command="{Binding NewFolderCommand}"
                ToolTip.Tip="{x:Static s:Strings.AddFolder}">
          <Panel Width="19" Height="19">
            <Path Data="{StaticResource FolderIcon}" Fill="White" Width="15" Height="15" Stretch="Uniform"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <!-- Artı, düğme renginde bir halkanın içinde: simgeden ayrı görünsün. -->
            <Border Width="11" Height="11" CornerRadius="6" Background="{DynamicResource ButtonBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
              <Path Data="{StaticResource PlusIcon}" Stroke="White" StrokeThickness="1.8" Width="7" Height="7" Stretch="Uniform" />
            </Border>
          </Panel>
        </Button>
      </Grid>
    </StackPanel>

    <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Classes="sidebar-footer" Command="{Binding OpenSettingsCommand}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Path Data="{StaticResource GearIcon}" Fill="{DynamicResource Text2Brush}" Width="15" Height="15" Stretch="Uniform" />
        <TextBlock Text="{x:Static s:Strings.Settings}" />
      </StackPanel>
    </Button>
    <Panel Margin="4,0,4,8">
    <TreeView x:Name="Tree" ItemsSource="{Binding Tree.Roots}" SelectedItem="{Binding Tree.Selected}" DoubleTapped="OnTreeDoubleTapped"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="IsVisible" Value="{Binding IsVisible}" />
          <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
          <Setter Property="MinHeight" Value="44" />
        </Style>
      </TreeView.Styles>
      <TreeView.DataTemplates>
        <TreeDataTemplate DataType="vm:GroupNodeViewModel" ItemsSource="{Binding Children}">
          <Grid ColumnDefinitions="Auto,*" Margin="0,4" Background="Transparent">
            <Grid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static s:Strings.AddServer}"
                          Command="{Binding $parent[v:SidebarView].((vm:MainWindowViewModel)DataContext).NewServerInCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="{x:Static s:Strings.Edit}"
                          Command="{Binding $parent[v:SidebarView].((vm:MainWindowViewModel)DataContext).EditCommand}" CommandParameter="{Binding}" />
                <Separator />
                <MenuItem Classes="danger" Header="{x:Static s:Strings.Delete}"
                          Command="{Binding $parent[v:SidebarView].((vm:MainWindowViewModel)DataContext).DeleteNodeCommand}" CommandParameter="{Binding}" />
              </ContextMenu>
            </Grid.ContextMenu>
            <Border Classes="tile-small" Background="{Binding Color, Converter={x:Static v:Converters.ServerColorBrush}}">
              <Path Data="{StaticResource FolderIcon}" Fill="White" Width="13" Height="13" Stretch="Uniform" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="12,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
        </TreeDataTemplate>
        <DataTemplate DataType="vm:ServerNodeViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3" Background="Transparent">
            <Grid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static s:Strings.Connect}"
                          Command="{Binding $parent[v:SidebarView].((vm:MainWindowViewModel)DataContext).ConnectCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="{x:Static s:Strings.Edit}"
                          Command="{Binding $parent[v:SidebarView].((vm:MainWindowViewModel)DataContext).EditCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="{x:Static s:Strings.Copy}"
                          Command="{Binding $parent[v:SidebarView].((vm:MainWindowViewModel)DataContext).CopyServerCommand}" CommandParameter="{Binding}" />
                <Separator />
                <MenuItem Classes="danger" Header="{x:Static s:Strings.Delete}"
                          Command="{Binding $parent[v:SidebarView].((vm:MainWindowViewModel)DataContext).DeleteNodeCommand}" CommandParameter="{Binding}" />
              </ContextMenu>
            </Grid.ContextMenu>
            <Border Classes="tile" Background="{Binding Color, Converter={x:Static v:Converters.ServerColorBrush}}">
              <v:ServerIconView Icon="{Binding Icon}" Width="15" Height="15" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="secondary" Text="{Binding Host}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- Oturum durumu: bağlanırken halka, bağlıyken yeşil, koptuğunda turuncu (docs/tasarim/rdp-oturumu.png, e). -->
            <Panel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
              <Arc x:Name="ConnectingMark" Classes="spinner" Width="10" Height="10" StartAngle="0" SweepAngle="100"
                   Stroke="{StaticResource ConnectedBrush}" StrokeThickness="2" IsVisible="{Binding IsConnecting}" />
              <Ellipse x:Name="ConnectedMark" Width="8" Height="8" Fill="{StaticResource ConnectedBrush}" IsVisible="{Binding IsConnected}" />
              <Ellipse x:Name="DisconnectedMark" Width="8" Height="8" Fill="{StaticResource NoticeBrush}" IsVisible="{Binding IsDisconnected}" />
            </Panel>
          </Grid>
        </DataTemplate>
      </TreeView.DataTemplates>
    </TreeView>
    <!-- Sürükle-bırak göstergesi: satır arasına mavi çizgi, klasörün içine bırakırken çerçeve. -->
    <Canvas IsHitTestVisible="False">
      <Border x:Name="DropLine" Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" IsVisible="False" />
      <Border x:Name="DropHighlight" BorderThickness="2" CornerRadius="{StaticResource RadiusLarge}"
              BorderBrush="{DynamicResource AccentBrush}" IsVisible="False" />
    </Canvas>
    </Panel>
  </DockPanel>
</UserControl>
