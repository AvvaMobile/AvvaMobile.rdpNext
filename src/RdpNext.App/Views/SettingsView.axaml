<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpNext.App.ViewModels"
             xmlns:s="using:RdpNext.App.Strings"
             x:Class="RdpNext.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource CardBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="subtabs">
      <StackPanel Orientation="Horizontal">
        <RadioButton Classes="subtab" Content="{x:Static s:Strings.General}" IsChecked="{Binding ShowGeneral}" />
        <RadioButton Classes="subtab" Content="{x:Static s:Strings.Export}" IsChecked="{Binding ShowExport}" />
        <RadioButton Classes="subtab" Content="{x:Static s:Strings.Import}" IsChecked="{Binding ShowImport}" />
      </StackPanel>
    </Border>
    <ScrollViewer>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1000*" MaxWidth="876" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Panel>
          <!-- Genel: şimdilik boş, ayarlar buraya eklenecek. -->
          <StackPanel Classes="form" IsVisible="{Binding ShowGeneral}" />
          <StackPanel Classes="form" IsVisible="{Binding ShowExport}">
            <TextBlock x:Name="ExportHint" Text="{x:Static s:Strings.ExportHint}" TextWrapping="Wrap" />
            <Button x:Name="ExportButton" Classes="primary" Content="{x:Static s:Strings.Export}" Command="{Binding ExportCommand}" />
            <TextBlock Classes="secondary" Text="{Binding Status}" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <StackPanel Classes="form" IsVisible="{Binding ShowImport}">
            <TextBlock x:Name="ImportHint" Text="{x:Static s:Strings.ImportHint}" TextWrapping="Wrap" />
            <CheckBox x:Name="DeleteOldBox" Content="{x:Static s:Strings.DeleteOld}" IsChecked="{Binding DeleteOld}" />
            <Button x:Name="ImportButton" Classes="primary" Content="{x:Static s:Strings.Import}" Command="{Binding ImportCommand}" />
            <TextBlock Classes="secondary" Text="{Binding Status}" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Panel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
