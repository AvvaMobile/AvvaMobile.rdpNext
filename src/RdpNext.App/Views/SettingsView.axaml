<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpNext.App.ViewModels"
             xmlns:s="using:RdpNext.App.Strings"
             x:Class="RdpNext.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource CardBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="subtabs">
      <StackPanel Orientation="Horizontal">
        <RadioButton Classes="subtab" Content="{x:Static s:Strings.General}" IsChecked="{Binding ShowGeneral}" />
        <RadioButton Classes="subtab" Content="{x:Static s:Strings.Export}" IsChecked="{Binding ShowExport}" />
        <RadioButton Classes="subtab" Content="{x:Static s:Strings.Import}" IsChecked="{Binding ShowImport}" />
      </StackPanel>
    </Border>
    <ScrollViewer>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1000*" MaxWidth="876" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Panel>
          <StackPanel Classes="form" IsVisible="{Binding ShowGeneral}">
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel>
                <TextBlock Classes="label" Text="{x:Static s:Strings.Theme}" />
                <ComboBox x:Name="ThemeBox" Classes="field" SelectedIndex="{Binding ThemeIndex}">
                  <ComboBoxItem Content="{x:Static s:Strings.ThemeDark}" />
                  <ComboBoxItem Content="{x:Static s:Strings.ThemeLight}" />
                  <ComboBoxItem Content="{x:Static s:Strings.ThemeSystem}" />
                </ComboBox>
              </StackPanel>
            </Grid>
            <Button x:Name="SaveGeneralButton" Classes="primary" Content="{x:Static s:Strings.Save}" Command="{Binding SaveGeneralCommand}"
                    Margin="0,6,0,0" />
          </StackPanel>
          <StackPanel Classes="form" IsVisible="{Binding ShowExport}">
            <TextBlock x:Name="ExportHint" Text="{x:Static s:Strings.ExportHint}" TextWrapping="Wrap" />
            <Button x:Name="ExportButton" Classes="primary" Content="{x:Static s:Strings.Export}" Command="{Binding ExportCommand}" />
            <TextBlock Classes="secondary" Text="{Binding Status}" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <!-- İçe aktar: alt alta iki bölüm (docs/tasarim/mremoteng-ice-aktarma.html). -->
          <StackPanel Classes="form" IsVisible="{Binding ShowImport}">
            <TextBlock Classes="card-title" Text="{x:Static s:Strings.ImportFromRdpNext}" />
            <TextBlock x:Name="ImportHint" Classes="secondary" Text="{x:Static s:Strings.ImportHint}" TextWrapping="Wrap" LineHeight="20" />
            <CheckBox x:Name="DeleteOldBox" Content="{x:Static s:Strings.DeleteOld}" IsChecked="{Binding DeleteOld}" />
            <Button x:Name="ImportButton" Classes="primary" Content="{x:Static s:Strings.Import}" Command="{Binding ImportCommand}" />
            <TextBlock Classes="secondary" Text="{Binding Status}" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,10" />
            <TextBlock Classes="card-title" Text="{x:Static s:Strings.ImportFromMRemoteNg}" />
            <TextBlock x:Name="MRemoteNgHint" Classes="secondary" Text="{x:Static s:Strings.MRemoteNgHint}" TextWrapping="Wrap" LineHeight="20" />
            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static s:Strings.MasterPassword}" />
              <TextBox x:Name="MasterPasswordBox" Classes="field" Text="{Binding MasterPassword}" PlaceholderText="{x:Static s:Strings.Optional}"
                       PasswordChar="•" RevealPassword="{Binding IsMasterPasswordVisible}">
                <TextBox.InnerRightContent>
                  <ToggleButton Classes="eye" IsChecked="{Binding IsMasterPasswordVisible}">
                    <Path Data="{StaticResource EyeIcon}" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6"
                          Width="16" Height="16" Stretch="Uniform" />
                  </ToggleButton>
                </TextBox.InnerRightContent>
              </TextBox>
              <TextBlock Classes="secondary hint" Text="{x:Static s:Strings.MasterPasswordHint}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="ImportMRemoteNgButton" Classes="primary" Content="{x:Static s:Strings.Import}" Command="{Binding ImportMRemoteNgCommand}" />
            <TextBlock Classes="secondary" Text="{Binding MRemoteNgStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding MRemoteNgStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Panel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
