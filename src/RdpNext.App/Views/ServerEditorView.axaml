<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpNext.App.ViewModels"
             xmlns:v="using:RdpNext.App.Views"
             xmlns:m="using:RdpNext.Core.Model"
             xmlns:s="using:RdpNext.App.Strings"
             x:Class="RdpNext.App.Views.ServerEditorView"
             x:DataType="vm:ServerEditorViewModel"
             Background="{DynamicResource CardBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="subtabs">
      <StackPanel Orientation="Horizontal">
        <RadioButton Classes="subtab" Content="{x:Static s:Strings.General}" IsChecked="{Binding ShowGeneral}" />
        <RadioButton x:Name="AdvancedTab" Classes="subtab" Content="{x:Static s:Strings.Advanced}" IsChecked="{Binding ShowAdvanced}" IsEnabled="{Binding IsRdp}" />
      </StackPanel>
    </Border>
    <!-- İki sekme aynı formda; altta her iki sekmede de görünen tek Save her şeyi kaydeder. -->
    <ScrollViewer>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1000*" MaxWidth="876" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Classes="form" Spacing="24">
        <StackPanel Spacing="24" IsVisible="{Binding ShowGeneral}">
          <Grid ColumnDefinitions="*,30,*">
            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static s:Strings.ConnectionType}" />
              <Border Classes="segmented">
                <UniformGrid Columns="3">
                  <RadioButton x:Name="WindowsType" Classes="segment" IsChecked="{Binding IsWindows}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="20" Height="20" CornerRadius="6" Background="{Binding Color, Converter={x:Static v:Converters.ServerColorBrush}}">
                        <v:ServerIconView Icon="Windows" Width="10" Height="10" />
                      </Border>
                      <TextBlock VerticalAlignment="Center" Text="{x:Static s:Strings.WindowsType}" />
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="SshType" Classes="segment" IsChecked="{Binding IsSsh}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="20" Height="20" CornerRadius="6" Background="{Binding Color, Converter={x:Static v:Converters.ServerColorBrush}}">
                        <v:ServerIconView Icon="Ssh" Width="10" Height="10" />
                      </Border>
                      <TextBlock VerticalAlignment="Center" Text="{x:Static s:Strings.SshType}" />
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="LinuxType" Classes="segment" IsChecked="{Binding IsLinux}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="20" Height="20" CornerRadius="6" Background="{Binding Color, Converter={x:Static v:Converters.ServerColorBrush}}">
                        <v:ServerIconView Icon="Linux" Width="10" Height="10" />
                      </Border>
                      <TextBlock VerticalAlignment="Center" Text="{x:Static s:Strings.LinuxType}" />
                    </StackPanel>
                  </RadioButton>
                </UniformGrid>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="{x:Static s:Strings.Color}" />
              <ListBox Classes="swatches" ItemsSource="{Binding Colors}" SelectedItem="{Binding Color}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="m:ServerColor">
                    <Border Width="30" Height="30" CornerRadius="8"
                            Background="{Binding Converter={x:Static v:Converters.ServerColorBrush}}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,30,*">
            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static s:Strings.DisplayName}" />
              <TextBox Classes="field" Text="{Binding Name}" PlaceholderText="{Binding Host}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="{x:Static s:Strings.Folder}" />
              <ComboBox Classes="field" ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:FolderOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,30,140">
            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static s:Strings.Address}" />
              <TextBox x:Name="HostBox" Classes="field" Text="{Binding Host}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="{x:Static s:Strings.Port}" />
              <TextBox Classes="field" Text="{Binding Port}" />
            </StackPanel>
          </Grid>
          <!-- Şifre alanı tek; yeri tipe göre değişir: RDP'de kullanıcının yanı, SSH'de alt satır. -->
          <Grid ColumnDefinitions="*,30,*" RowDefinitions="Auto,24,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static s:Strings.User}" />
              <TextBox Classes="field" Text="{Binding Username}" PlaceholderText="{Binding UsernameHint}">
                <TextBox.InnerRightContent>
                  <TextBlock Classes="source" Text="{Binding UsernameSource}" IsVisible="{Binding ShowUsernameSource}" />
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>
            <StackPanel x:Name="AuthBox" Grid.Column="2" IsVisible="{Binding IsSsh}">
              <TextBlock Classes="label" Text="{x:Static s:Strings.SignInMethod}" />
              <Border Classes="segmented">
                <UniformGrid Columns="2">
                  <RadioButton Classes="segment" Content="{x:Static s:Strings.Password}" IsChecked="{Binding IsPasswordAuth}" />
                  <RadioButton Classes="segment" Content="{x:Static s:Strings.KeyFile}" IsChecked="{Binding IsKeyAuth}" />
                </UniformGrid>
              </Border>
            </StackPanel>
            <StackPanel x:Name="DomainBox" Grid.Row="2" IsVisible="{Binding IsRdp}">
              <TextBlock Classes="label" Text="{x:Static s:Strings.Domain}" />
              <TextBox Classes="field" Text="{Binding Domain}" PlaceholderText="{Binding DomainHint}">
                <TextBox.InnerRightContent>
                  <TextBlock Classes="source" Text="{Binding DomainSource}" IsVisible="{Binding ShowDomainSource}" />
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>
            <StackPanel x:Name="KeyFileBox" Grid.Row="2" IsVisible="{Binding IsKeyAuth}">
              <TextBlock Classes="label" Text="{x:Static s:Strings.KeyFile}" />
              <TextBox Classes="field" Text="{Binding KeyFile}">
                <TextBox.InnerRightContent>
                  <Button Classes="secondary" Margin="0,0,6,0" Content="{x:Static s:Strings.Choose}" Command="{Binding ChooseKeyFileCommand}" />
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>
            <StackPanel x:Name="PasswordBox" Grid.Row="{Binding PasswordRow}" Grid.Column="{Binding PasswordColumn}">
              <TextBlock Classes="label" Text="{Binding PasswordLabel}" />
              <TextBox Classes="field" Text="{Binding Password}" PlaceholderText="{Binding PasswordHint}"
                       PasswordChar="•" RevealPassword="{Binding IsPasswordVisible}">
                <TextBox.InnerRightContent>
                  <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="source" Text="{Binding PasswordSource}" IsVisible="{Binding ShowPasswordSource}" />
                  <ToggleButton Classes="eye" IsChecked="{Binding IsPasswordVisible}">
                    <Path Data="{StaticResource EyeIcon}" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6"
                          Width="16" Height="16" Stretch="Uniform" />
                  </ToggleButton>
                  </StackPanel>
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>
          </Grid>
        </StackPanel>
        <StackPanel Spacing="24" IsVisible="{Binding ShowAdvanced}">
          <Grid ColumnDefinitions="*,30,*">
            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static s:Strings.Screen}" />
              <ComboBox x:Name="ScreenBox" Classes="field" SelectedIndex="{Binding ScreenIndex}">
                <ComboBoxItem Content="{x:Static s:Strings.FullScreen}" />
                <ComboBoxItem Content="{x:Static s:Strings.Windowed}" />
              </ComboBox>
            </StackPanel>
          </Grid>
          <CheckBox x:Name="InfoOverlayBox" Content="{x:Static s:Strings.ShowInfoOverlay}" IsChecked="{Binding ShowInfoOverlay}" />
        </StackPanel>
          <Button x:Name="SaveButton" Classes="primary" HorizontalAlignment="Left" Margin="0,6,0,0"
                  Content="{x:Static s:Strings.Save}" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
