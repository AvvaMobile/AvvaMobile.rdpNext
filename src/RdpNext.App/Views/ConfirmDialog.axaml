<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:RdpNext.App.Strings"
        x:Class="RdpNext.App.Views.ConfirmDialog"
        Width="420" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Title="rdpNext">
  <StackPanel Margin="24" Spacing="22">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="16" />
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Classes="secondary" Content="{x:Static s:Strings.Cancel}" IsCancel="True" />
      <Button x:Name="ConfirmButton" Classes="danger" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
