<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpNext.App.ViewModels"
             xmlns:s="using:RdpNext.App.Strings"
             x:Class="RdpNext.App.Views.FolderEditorView"
             x:DataType="vm:FolderEditorViewModel"
             Background="{DynamicResource CardBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="subtabs">
      <StackPanel Orientation="Horizontal">
        <RadioButton Classes="subtab" Content="{x:Static s:Strings.General}" IsChecked="True" />
      </StackPanel>
    </Border>
      <ScrollViewer>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1000*" MaxWidth="876" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
        <StackPanel Classes="form">
          <!-- Şimdilik yalnız ad; kimlik bilgileri ve üst klasör ekrandan kaldırıldı. -->
          <Grid ColumnDefinitions="*,12,*">
            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static s:Strings.Name}" />
              <TextBox x:Name="FolderNameBox" Classes="field" Text="{Binding Name}" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
            <Button x:Name="SaveFolderButton" Classes="primary" Content="{x:Static s:Strings.Save}" Command="{Binding SaveCommand}" />
            <Button x:Name="DeleteFolderButton" Grid.Column="1" HorizontalAlignment="Right" Classes="danger" Command="{Binding DeleteCommand}" IsVisible="{Binding !IsNew}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{StaticResource TrashIcon}" Fill="White" Width="13" Height="14" Stretch="Uniform" />
                <TextBlock Text="{x:Static s:Strings.Delete}" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
        </Grid>
      </ScrollViewer>
  </DockPanel>
</UserControl>
